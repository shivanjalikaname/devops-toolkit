# Copy to .env next to compose.yaml. Every value has a default in compose.yaml.

# 0.0.0.0 exposes the UIs on every interface - only do that behind a firewall/proxy.
BIND_ADDR=127.0.0.1

PROMETHEUS_VERSION=v2.55.1
ALERTMANAGER_VERSION=v0.27.0
NODE_EXPORTER_VERSION=v1.8.2

# whichever limit is hit first wins
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=10GB

# used in alert links; set to the URL people actually open
PROMETHEUS_EXTERNAL_URL=http://127.0.0.1:9090
ALERTMANAGER_EXTERNAL_URL=http://127.0.0.1:9093
